# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Only placeholder values belong here. Real keys go in .env.local (gitignored)
# or in /opt/yaptok/.env on the server. Every setting is read on the server
# at request time, so one build or Docker image works with any values.
#
# Everything is optional. With nothing filled in the app still runs and shows
# "database not connected".

# --- Supabase (the database and sign in) -------------------------------------
# Your project's URL and publishable key, from the project's API keys page
# (https://supabase.com/dashboard/project/_/settings/api-keys). Both are public
# by design: they end up in the browser, and row level security protects the
# data. Set both or neither.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare R2 (where the clips are stored) -------------------------------
# Server only, never NEXT_PUBLIC. Without all four, uploads are not configured:
# /api/upload/sign refuses and clips cannot be played through /api/media.
# ops/app/README.md explains the bucket, the API token and the CORS rule.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional. A public domain connected to the bucket, for example
# https://media.example.com. When set, the player loads clips straight from
# it instead of through /api/media. Everything under hls/ is then public to
# whoever has the link, private clips included. Leave it empty if unsure.
MEDIA_PUBLIC_URL=

# (GIT_SHA, the commit /api/version shows, is set by the Docker build.)

# The encoder worker (worker/) has its own settings: see worker/.env.example.

# Optional, for local testing only: another S3 compatible address instead of
# R2's own. scripts/local-stack.mjs prints the value for its stand in. Leave it
# empty on a real server.
R2_ENDPOINT=
